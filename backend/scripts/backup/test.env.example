# Test Environment Configuration
# Copy this to .env and update with your test database credentials

# Production Supabase (your existing database)
SUPABASE_URL=your_production_supabase_url
SUPABASE_ANON_KEY=your_production_supabase_key

# Test Supabase (separate database for testing backup/restore)
# Create a separate Supabase project for testing to avoid affecting production
TEST_SUPABASE_URL=your_test_supabase_url  
TEST_SUPABASE_ANON_KEY=your_test_supabase_key

# Instructions:
# 1. Create a new Supabase project for testing
# 2. Copy the same database schema as your production database
# 3. Add the test credentials above
# 4. Run: node test_backup.js test